// 통인 ERP — Prisma 스키마 (초기 핵심 마스터 4종)
// 전체 설계는 루트 DB스키마-설계.md 참조. 여기는 FND-01 스켈레톤용 시드 모델.
// 명명: 모델은 PascalCase, 실제 테이블/컬럼은 snake_case(@@map/@map).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OrgUnit {
  id              String     @id @default(uuid()) @db.Uuid
  parentId        String?    @map("parent_id") @db.Uuid
  parent          OrgUnit?   @relation("OrgUnitParent", fields: [parentId], references: [id])
  children        OrgUnit[]  @relation("OrgUnitParent")
  type            String // GROUP | COMPANY | BRANCH | PARTNER
  code            String     @unique
  name            String
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  employees       Employee[]
  customers       Customer[]
  userRoleScopes  UserRole[] @relation("UserRoleOrgScope")
  brandedProducts Product[]  @relation("ProductBrand")
  leads           Lead[]

  estimates       Estimate[]
  contracts       Contract[]
  workOrders      WorkOrder[]
  commissionRules CommissionRule[] @relation("CommissionRuleOrg")
  materialOrders  MaterialOrder[]
  calendarEvents  CalendarEvent[]

  @@map("org_unit")
}

model CommonCode {
  id        String  @id @default(uuid()) @db.Uuid
  codeGroup String  @map("code_group")
  code      String
  name      String
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  @@unique([codeGroup, code])
  @@map("common_code")
}

model Employee {
  id         String    @id @default(uuid()) @db.Uuid
  orgUnitId  String    @map("org_unit_id") @db.Uuid
  orgUnit    OrgUnit   @relation(fields: [orgUnitId], references: [id])
  empNo      String?   @unique @map("emp_no")
  name       String
  phone      String?
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  appUsers   AppUser[]
  ownedLeads Lead[]

  estimatorEstimates Estimate[]
  assignments        WorkAssignment[]

  @@map("employee")
}

model Customer {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  phonePrimary String?    @map("phone_primary")
  legacyId     String?    @map("legacy_id") // 레거시 memID 보존(마이그레이션 crosswalk)
  grade        String?
  status       String?
  zipcode      String? // 카카오/다음 우편번호
  addr         String? // 도로명주소
  addrDetail   String?    @map("addr_detail")
  sido         String?
  sigungu      String?
  lat          Float?
  lng          Float?
  ownerOrgId   String?    @map("owner_org_id") @db.Uuid
  ownerOrg     OrgUnit?   @relation(fields: [ownerOrgId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  leads        Lead[]
  estimates    Estimate[]
  contracts    Contract[]

  @@index([phonePrimary])
  @@map("customer")
}

// ── FND-03: 인증 + RBAC (역할 × 기능 × 데이터범위 × 조직) ──
// DB스키마-설계.md §2 기반 + 설계노트 1-B(에이전트=1급 주체) 반영.

model AppUser {
  id            String     @id @default(uuid()) @db.Uuid
  employeeId    String?    @map("employee_id") @db.Uuid // 직원 계정(외부인·에이전트는 NULL)
  employee      Employee?  @relation(fields: [employeeId], references: [id])
  loginId       String     @unique @map("login_id")
  passwordHash  String?    @map("password_hash") // 에이전트/워크플로우는 NULL(토큰 인증)
  principalType String     @default("HUMAN") @map("principal_type") // HUMAN | AGENT | WORKFLOW (1-B)
  isExternal    Boolean    @default(false) @map("is_external")
  isActive      Boolean    @default(true) @map("is_active")
  partnerId     String?    @map("partner_id") @db.Uuid // 외부 전속/제휴 사용자 소속(데이터범위 스코프, OPS-04)
  partner       Partner?   @relation(fields: [partnerId], references: [id])
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  userRoles     UserRole[]
  apiTokens     ApiToken[]

  calendarEvents     CalendarEvent[]
  googleCalendarLink GoogleCalendarLink?

  @@map("app_user")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  rolePerms   RolePermission[]
  userRoles   UserRole[]

  @@map("role")
}

model Permission {
  id        String           @id @default(uuid()) @db.Uuid
  code      String           @unique // 예: ORG_UNIT.READ, CONTRACT.APPROVE
  name      String
  rolePerms RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String   @map("role_id") @db.Uuid
  role       Role     @relation(fields: [roleId], references: [id])
  orgScopeId String?  @map("org_scope_id") @db.Uuid // 이 조직(+하위)만
  orgScope   OrgUnit? @relation("UserRoleOrgScope", fields: [orgScopeId], references: [id])
  dataScope  String   @default("OWN") @map("data_scope") // OWN | ORG | ALL

  @@unique([userId, roleId, orgScopeId])
  @@map("user_role")
}

// 에이전트/워크플로우(및 PAT) 스코프 토큰 — 사람과 동일 RBAC + 권한 부분집합·만료·폐기 (1-B)
model ApiToken {
  id          String    @id @default(uuid()) @db.Uuid
  principalId String    @map("principal_id") @db.Uuid
  principal   AppUser   @relation(fields: [principalId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String    @unique @map("token_hash") // 평문 토큰은 발급 시 1회만 노출
  scopes      String[]  @default([]) // 허용 permission code 부분집합('*'=주체 권한 전체)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("api_token")
}

// ── FND-09: 서비스 카탈로그 4엔티티 (부록 D-2) + 거래처(Partner) ──
// 레거시 Item 1테이블에 섞여있던 4개념을 분리: 판매상품/품목사전/옵션/가격조건.

model Partner {
  id              String           @id @default(uuid()) @db.Uuid
  type            String // AFFILIATE(제휴) | OUTSOURCE(전속) | B2B_CLIENT
  code            String           @unique
  name            String
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  priceConditions PriceCondition[]
  leads           Lead[]

  workOrders WorkOrder[]
  invoices   Invoice[]
  appUsers   AppUser[]

  @@map("partner")
}

// A. 판매상품(SKU): 고객이 사는 것, 견적/계약 라인에 오름
model Product {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  name          String
  category      String? // common_code: PRODUCT_CATEGORY (가정이사/사무실이사/보관…)
  serviceLine   String   @map("service_line") // common_code: SERVICE_LINE
  pricingMethod String   @map("pricing_method") // CBM | COST_PLUS | FLAT | PYEONG
  basePrice     Decimal? @map("base_price") @db.Decimal(14, 2) // 기본(디폴트) 가격
  brandOrgId    String?  @map("brand_org_id") @db.Uuid
  brandOrg      OrgUnit? @relation("ProductBrand", fields: [brandOrgId], references: [id])
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  estimates Estimate[]
  addons    ProductAddon[]

  @@map("product")
}

// 상품 ↔ 옵션(부가서비스) 연결 (상품별 제공 옵션). 가격 override 가능.
model ProductAddon {
  productId      String       @map("product_id") @db.Uuid
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  addonServiceId String       @map("addon_service_id") @db.Uuid
  addon          AddonService @relation(fields: [addonServiceId], references: [id], onDelete: Cascade)
  priceOverride  Decimal?     @map("price_override") @db.Decimal(14, 2) // 상품별 옵션가(없으면 옵션 기본가)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([productId, addonServiceId])
  @@map("product_addon")
}

// B. CBM 품목사전: 짐량 측정용 표준 사전 (단일 표준·중복방지)
model CbmItem {
  id            String         @id @default(uuid()) @db.Uuid
  category      String // common_code: ITEM_CATEGORY
  name          String
  cbm           Decimal        @db.Decimal(8, 2)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  estimateLines EstimateLine[]

  @@unique([category, name])
  @@map("cbm_item")
}

// C. 옵션/부가서비스: 애드온 (분해설치·사다리차·보관…)
model AddonService {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  unit      String // EA | FLAT
  price     Decimal? @db.Decimal(14, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  products ProductAddon[]

  @@map("addon_service")
}

// ── FND-07: 이벤트(outbox) + 감사로그 ──
// 전표 원칙(모든 변경 불변기록) + AI 개방(이벤트 디스패치) 토대. 설계노트 1-A/1-B, DB스키마 §9.

model DomainEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type") // 예: org_unit
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type") // 예: org_unit.created
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)

  @@index([aggregateType, aggregateId])
  @@index([publishedAt])
  @@map("domain_event")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String   @map("entity_type") // 라우트 리소스(예: org-units)
  entityId    String?  @map("entity_id")
  action      String // CREATE | UPDATE | DELETE
  actorUserId String?  @map("actor_user_id") @db.Uuid
  method      String
  path        String
  statusCode  Int      @map("status_code")
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_log")
}

// D. 가격조건(제휴/프로모션): 상품 아님 → 거래처 + 조건 오버레이
model PriceCondition {
  id            String    @id @default(uuid()) @db.Uuid
  partnerId     String?   @map("partner_id") @db.Uuid
  partner       Partner?  @relation(fields: [partnerId], references: [id])
  name          String
  discountType  String    @map("discount_type") // RATE | AMOUNT | FIXED_PRICE
  discountValue Decimal   @map("discount_value") @db.Decimal(14, 2)
  validFrom     DateTime? @map("valid_from") @db.Date
  validTo       DateTime? @map("valid_to") @db.Date
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("price_condition")
}

// ── Phase 1: 리드(접수) — 이사 프로세스의 출발점 (DB스키마 §5) ──
model Lead {
  id             String      @id @default(uuid()) @db.Uuid
  leadNo         String      @unique @map("lead_no") // 접수번호 R...
  customerId     String?     @map("customer_id") @db.Uuid
  customer       Customer?   @relation(fields: [customerId], references: [id])
  orgUnitId      String      @map("org_unit_id") @db.Uuid // 담당 지점
  orgUnit        OrgUnit     @relation(fields: [orgUnitId], references: [id])
  ownerEmpId     String?     @map("owner_emp_id") @db.Uuid
  ownerEmp       Employee?   @relation(fields: [ownerEmpId], references: [id])
  partnerId      String?     @map("partner_id") @db.Uuid // 제휴/전속 출처
  partner        Partner?    @relation(fields: [partnerId], references: [id])
  source         String? // common_code: RECEIPT_PATH
  serviceLine    String?     @map("service_line")
  status         String      @default("RECEIVED") // 상태머신(shared LEAD_STATUS)
  fromZipcode    String?     @map("from_zipcode")
  fromAddr       String?     @map("from_addr") // 도로명주소(카카오/다음 우편번호)
  fromAddrDetail String?     @map("from_addr_detail") // 상세주소
  fromSido       String?     @map("from_sido")
  fromSigungu    String?     @map("from_sigungu")
  fromLat        Float?      @map("from_lat") // 위도(카카오 Local geocode)
  fromLng        Float?      @map("from_lng") // 경도
  toZipcode      String?     @map("to_zipcode")
  toAddr         String?     @map("to_addr")
  toAddrDetail   String?     @map("to_addr_detail")
  toSido         String?     @map("to_sido")
  toSigungu      String?     @map("to_sigungu")
  toLat          Float?      @map("to_lat")
  toLng          Float?      @map("to_lng")
  moveDate       DateTime?   @map("move_date") @db.Date
  visitDate      DateTime?   @map("visit_date") @db.Date
  expectedAmount Decimal?    @map("expected_amount") @db.Decimal(14, 2)
  attributes     Json?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime?   @updatedAt @map("updated_at") @db.Timestamptz(6)
  estimates      Estimate[]
  contracts      Contract[]
  workOrders     WorkOrder[]

  @@index([status])
  @@index([orgUnitId])
  @@map("lead")
}

// ── Phase 1: 견적 (부록 E·F) — 헤더 + 구역 + 품목라인 ──
model Estimate {
  id               String               @id @default(uuid()) @db.Uuid
  estimateNo       String               @unique @map("estimate_no")
  leadId           String               @map("lead_id") @db.Uuid
  lead             Lead                 @relation(fields: [leadId], references: [id])
  customerId       String               @map("customer_id") @db.Uuid
  customer         Customer             @relation(fields: [customerId], references: [id])
  orgUnitId        String               @map("org_unit_id") @db.Uuid
  orgUnit          OrgUnit              @relation(fields: [orgUnitId], references: [id])
  productId        String               @map("product_id") @db.Uuid
  product          Product              @relation(fields: [productId], references: [id])
  estimatorEmpId   String?              @map("estimator_emp_id") @db.Uuid
  estimator        Employee?            @relation(fields: [estimatorEmpId], references: [id])
  fromZipcode      String?              @map("from_zipcode")
  fromAddr         String?              @map("from_addr") // 도로명주소
  fromAddrDetail   String?              @map("from_addr_detail")
  fromSido         String?              @map("from_sido")
  fromSigungu      String?              @map("from_sigungu")
  fromLat          Float?               @map("from_lat")
  fromLng          Float?               @map("from_lng")
  fromPyeong       Int?                 @map("from_pyeong")
  fromElevator     Boolean?             @map("from_elevator")
  toZipcode        String?              @map("to_zipcode")
  toAddr           String?              @map("to_addr")
  toAddrDetail     String?              @map("to_addr_detail")
  toSido           String?              @map("to_sido")
  toSigungu        String?              @map("to_sigungu")
  toLat            Float?               @map("to_lat")
  toLng            Float?               @map("to_lng")
  toPyeong         Int?                 @map("to_pyeong")
  toElevator       Boolean?             @map("to_elevator")
  totalCbm         Decimal              @default(0) @map("total_cbm") @db.Decimal(10, 2)
  baseAmount       Decimal?             @map("base_amount") @db.Decimal(14, 2)
  totalAmount      Decimal?             @map("total_amount") @db.Decimal(14, 2)
  workInstructions String?              @map("work_instructions")
  status           String               @default("DRAFT") // DRAFT | QUOTED
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  zones            EstimateZone[]
  lines            EstimateLine[]
  costLines        EstimateCostLine[]
  costBuildup      EstimateCostBuildup?
  contract         Contract?

  @@index([leadId])
  @@map("estimate")
}

// EST-04: 기업이전(B2B) 원가 적상식 (설계노트 F-3). 견적당 1개(1:1).
// 합계 = 재료비(costLines) + 차량비 + 노무비 + 기타
// 총용역원가 = 합계 + 공과잡비 + 일반관리비 + 이윤 (각 비율은 합계 기준) → 견적가
model EstimateCostBuildup {
  estimateId   String   @id @map("estimate_id") @db.Uuid
  estimate     Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  vehicleCost  Decimal  @default(0) @map("vehicle_cost") @db.Decimal(14, 2) // 차량비
  laborCost    Decimal  @default(0) @map("labor_cost") @db.Decimal(14, 2) // 노무비
  etcCost      Decimal  @default(0) @map("etc_cost") @db.Decimal(14, 2) // 기타
  overheadRate Decimal  @default(0) @map("overhead_rate") @db.Decimal(6, 4) // 공과잡비율(0~1)
  adminRate    Decimal  @default(0) @map("admin_rate") @db.Decimal(6, 4) // 일반관리비율
  profitRate   Decimal  @default(0) @map("profit_rate") @db.Decimal(6, 4) // 이윤율
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("estimate_cost_buildup")
}

model EstimateZone {
  id         String         @id @default(uuid()) @db.Uuid
  estimateId String         @map("estimate_id") @db.Uuid
  estimate   Estimate       @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  name       String // 안방/거실/사무실 등 (유연)
  sortOrder  Int            @default(0) @map("sort_order")
  lines      EstimateLine[]

  @@map("estimate_zone")
}

model EstimateLine {
  id         String        @id @default(uuid()) @db.Uuid
  estimateId String        @map("estimate_id") @db.Uuid
  estimate   Estimate      @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  zoneId     String?       @map("zone_id") @db.Uuid
  zone       EstimateZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  cbmItemId  String?       @map("cbm_item_id") @db.Uuid
  cbmItem    CbmItem?      @relation(fields: [cbmItemId], references: [id])
  itemName   String        @map("item_name") // 스냅샷(품목명)
  qty        Decimal       @default(1) @db.Decimal(8, 2)
  cbm        Decimal       @default(0) @db.Decimal(8, 2) // 라인 합계 CBM (단위CBM×수량)
  handling   String        @default("CARRY") // common_code: HANDLING (운반/방치/폐기)
  memo       String?

  @@map("estimate_line")
}

// EST-03: 견적 재료비 라인 → 자재 소요/차감 연동 (설계노트 F-4)
// 흐름: 견적(재료비 산정) → 자재 소요량 → 자재·재고(MM) OUT 차감(전표) → 원가 반영.
model EstimateCostLine {
  id              String    @id @default(uuid()) @db.Uuid
  estimateId      String    @map("estimate_id") @db.Uuid
  estimate        Estimate  @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  materialId      String    @map("material_id") @db.Uuid
  material        Material  @relation(fields: [materialId], references: [id])
  qty             Int // 소요 수량(자재는 정수 단위 — 재고 수불과 일치)
  unitPrice       Decimal   @default(0) @map("unit_price") @db.Decimal(14, 2)
  totalPrice      Decimal   @default(0) @map("total_price") @db.Decimal(14, 2) // qty × unitPrice
  memo            String?
  status          String    @default("DRAFT") // DRAFT | DEDUCTED | CANCELED
  deductedAt      DateTime? @map("deducted_at") @db.Timestamptz(6)
  stockMovementId String?   @map("stock_movement_id") @db.Uuid // 차감 전표 추적
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([estimateId])
  @@map("estimate_cost_line")
}

// ── Phase 1: 계약 + 결제 (부록 E·11장) ──
model Contract {
  id            String    @id @default(uuid()) @db.Uuid
  contractNo    String    @unique @map("contract_no")
  estimateId    String    @unique @map("estimate_id") @db.Uuid
  estimate      Estimate  @relation(fields: [estimateId], references: [id])
  leadId        String    @map("lead_id") @db.Uuid
  lead          Lead      @relation(fields: [leadId], references: [id])
  customerId    String    @map("customer_id") @db.Uuid
  customer      Customer  @relation(fields: [customerId], references: [id])
  orgUnitId     String    @map("org_unit_id") @db.Uuid
  orgUnit       OrgUnit   @relation(fields: [orgUnitId], references: [id])
  contractDate  DateTime? @map("contract_date") @db.Date
  totalAmount   Decimal   @map("total_amount") @db.Decimal(14, 2)
  depositRatio  Decimal   @default(0.1) @map("deposit_ratio") @db.Decimal(5, 2)
  depositAmount Decimal   @map("deposit_amount") @db.Decimal(14, 2)
  balanceAmount Decimal   @map("balance_amount") @db.Decimal(14, 2)
  status        String    @default("DRAFT") // DRAFT | SIGNED | CANCELED
  snapshot      Json? // 서명 시점 동결 데이터(E-0)
  signedAt      DateTime? @map("signed_at") @db.Timestamptz(6)
  esignRef      String?   @map("esign_ref") // 전자계약 업체 참조(스텁)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  payments      Payment[]

  workOrder WorkOrder?

  @@map("contract")
}

model Payment {
  id             String    @id @default(uuid()) @db.Uuid
  contractId     String    @map("contract_id") @db.Uuid
  contract       Contract  @relation(fields: [contractId], references: [id])
  kind           String // DEPOSIT(계약금) | BALANCE(잔금)
  method         String    @default("VIRTUAL_ACCOUNT") // VIRTUAL_ACCOUNT | CARD | TRANSFER | CASH
  amount         Decimal   @db.Decimal(14, 2)
  status         String    @default("PENDING") // PENDING | PAID | CANCELED
  pgProvider     String    @default("TOSS") @map("pg_provider")
  pgRef          String?   @map("pg_ref")
  virtualAccount String?   @map("virtual_account")
  paidAt         DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([contractId])
  @@map("payment")
}

// SET-03: 전속/B2B 청구·수금 (설계노트 D-3). 거래처(전속/B2B) 대상 청구서 + 수금 기록.
model Invoice {
  id        String           @id @default(uuid()) @db.Uuid
  invoiceNo String           @unique @map("invoice_no")
  partnerId String           @map("partner_id") @db.Uuid
  partner   Partner          @relation(fields: [partnerId], references: [id])
  title     String
  amount    Decimal          @db.Decimal(14, 2) // 청구액
  status    String           @default("DRAFT") // DRAFT | ISSUED | COLLECTED | CANCELED
  issuedAt  DateTime?        @map("issued_at") @db.Timestamptz(6)
  dueDate   DateTime?        @map("due_date") @db.Date
  memo      String?
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  receipts  InvoiceReceipt[]

  @@index([partnerId])
  @@map("invoice")
}

// 수금 기록(청구서별 입금). 합계가 청구액 이상이면 COLLECTED.
model InvoiceReceipt {
  id         String   @id @default(uuid()) @db.Uuid
  invoiceId  String   @map("invoice_id") @db.Uuid
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(14, 2)
  method     String   @default("TRANSFER") // TRANSFER | CASH | CARD
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  memo       String?

  @@index([invoiceId])
  @@map("invoice_receipt")
}

// SET-02: 지점 정산 수수료 규칙 (권한=데이터). 지점×서비스라인×출처 → 정률/정액, 우선순위 매칭.
model CommissionRule {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  orgUnitId   String?  @map("org_unit_id") @db.Uuid // 특정 지점(null=전체)
  orgUnit     OrgUnit? @relation("CommissionRuleOrg", fields: [orgUnitId], references: [id])
  serviceLine String?  @map("service_line") // 특정 서비스라인(null=전체)
  source      String? // 특정 출처(접수경로, null=전체)
  calcType    String   @map("calc_type") // RATE | FIXED
  rate        Decimal? @db.Decimal(6, 4) // RATE: 0~1
  fixedAmount Decimal? @map("fixed_amount") @db.Decimal(14, 2) // FIXED: 건당 정액
  priority    Int      @default(0) // 높을수록 우선
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("commission_rule")
}

// ── Phase 1: 작업오더(서비스오더) + 배정 — 작업토스 이후 (부록 D-3) ──
model WorkOrder {
  id            String           @id @default(uuid()) @db.Uuid
  workNo        String           @unique @map("work_no")
  contractId    String           @unique @map("contract_id") @db.Uuid
  contract      Contract         @relation(fields: [contractId], references: [id])
  leadId        String           @map("lead_id") @db.Uuid
  lead          Lead             @relation(fields: [leadId], references: [id])
  orgUnitId     String           @map("org_unit_id") @db.Uuid // 작업 수행 지점
  orgUnit       OrgUnit          @relation(fields: [orgUnitId], references: [id])
  partnerId     String?          @map("partner_id") @db.Uuid // 전속 외주 시
  partner       Partner?         @relation(fields: [partnerId], references: [id])
  scheduledDate DateTime?        @map("scheduled_date") @db.Date
  status        String           @default("ASSIGNED") // ASSIGNED | IN_PROGRESS | DONE | CANCELED
  billedCost    Decimal?         @map("billed_cost") @db.Decimal(14, 2) // 전속 청구비용(원가)=마진 추적
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  assignments   WorkAssignment[]

  @@map("work_order")
}

model WorkAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  workOrderId  String    @map("work_order_id") @db.Uuid
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  employeeId   String?   @map("employee_id") @db.Uuid
  employee     Employee? @relation(fields: [employeeId], references: [id])
  resourceType String    @map("resource_type") // CREW | VEHICLE
  resourceRef  String?   @map("resource_ref") // 차량번호/외부인력명 등
  scheduledAt  DateTime? @map("scheduled_at") @db.Timestamptz(6)

  @@map("work_assignment")
}

// ── INT-01: 알림톡/SMS 발송 기록 (이벤트 구독 발송, 스텁) ──
model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  channel   String   @default("ALIMTALK") // ALIMTALK | SMS
  eventType String   @map("event_type")
  recipient String? // 수신자(고객 연락처 등)
  message   String
  status    String   @default("SENT") // SENT | FAILED (스텁은 SENT)
  payload   Json?
  sentAt    DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  @@index([eventType])
  @@map("notification")
}

// ── MM-01: 자재·재고 (자재마스터 + 입출고 수불 → 현재고는 수불 합산) ──
model Material {
  id                String              @id @default(uuid()) @db.Uuid
  code              String              @unique
  name              String
  category          String? // common_code: MATERIAL_CATEGORY (박스/포장지/유니폼…)
  unit              String              @default("EA") // EA | SET | ROLL | BOX
  safetyStock       Int                 @default(0) @map("safety_stock") // 안전재고(미만 시 경고)
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  movements         StockMovement[]
  estimateCostLines EstimateCostLine[]
  orderLines        MaterialOrderLine[]

  @@map("material")
}

// MM-02: 가맹점 발주 (지점이 본사에 박스·포장지·유니폼 발주 → 출고 시 본사 재고 OUT)
model MaterialOrder {
  id        String              @id @default(uuid()) @db.Uuid
  orderNo   String              @unique @map("order_no")
  orgUnitId String              @map("org_unit_id") @db.Uuid // 발주 지점
  orgUnit   OrgUnit             @relation(fields: [orgUnitId], references: [id])
  status    String              @default("REQUESTED") // REQUESTED | APPROVED | SHIPPED | CANCELED
  note      String?
  shippedAt DateTime?           @map("shipped_at") @db.Timestamptz(6)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  lines     MaterialOrderLine[]

  @@index([orgUnitId])
  @@map("material_order")
}

model MaterialOrderLine {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String        @map("order_id") @db.Uuid
  order           MaterialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  materialId      String        @map("material_id") @db.Uuid
  material        Material      @relation(fields: [materialId], references: [id])
  qty             Int
  stockMovementId String?       @map("stock_movement_id") @db.Uuid // 출고 전표 추적

  @@index([orderId])
  @@map("material_order_line")
}

model StockMovement {
  id         String   @id @default(uuid()) @db.Uuid
  materialId String   @map("material_id") @db.Uuid
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  orgUnitId  String?  @map("org_unit_id") @db.Uuid // 창고/지점(선택)
  type       String // IN(입고) | OUT(출고) | ADJUST(조정)
  qtyDelta   Int      @map("qty_delta") // 부호 포함: IN +, OUT -, ADJUST ±
  reason     String?
  refType    String?  @map("ref_type") // 연계 출처(발주/작업 등)
  refId      String?  @map("ref_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([materialId])
  @@map("stock_movement")
}

// ── CAT-01: 리빙·케어 서비스 주문 (이사 CBM 견적과 별개의 경량 서비스 주문) ──
model ServiceOrder {
  id            String    @id @default(uuid()) @db.Uuid
  orderNo       String    @unique @map("order_no")
  serviceLine   String    @map("service_line") // LIVING | CARE (홈케어/새집증후군/청소/엔딩케어)
  productId     String?   @map("product_id") @db.Uuid // 서비스 상품(scalar; 이름은 마스터에서 조회)
  customerId    String?   @map("customer_id") @db.Uuid
  orgUnitId     String    @map("org_unit_id") @db.Uuid // 담당 지점(데이터범위 스코프)
  scheduledDate DateTime? @map("scheduled_date") @db.Date
  address       String?
  amount        Decimal?  @db.Decimal(14, 2)
  note          String?
  status        String    @default("REQUESTED") // REQUESTED→SCHEDULED→DONE / CANCELED
  assignedEmpId String?   @map("assigned_emp_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orgUnitId])
  @@map("service_order")
}

// ── AS-01: CS·AS 접수/처리 (상담·불만=CS, 하자보수=AS) ──
model SupportTicket {
  id            String   @id @default(uuid()) @db.Uuid
  ticketNo      String   @unique @map("ticket_no")
  kind          String // CS | AS
  customerId    String?  @map("customer_id") @db.Uuid
  contractId    String?  @map("contract_id") @db.Uuid // AS는 원계약 연결
  orgUnitId     String   @map("org_unit_id") @db.Uuid // 담당 지점(데이터범위 스코프)
  channel       String? // PHONE | EMAIL | KAKAO | VISIT
  subject       String
  content       String?
  priority      String   @default("NORMAL") // LOW | NORMAL | HIGH
  status        String   @default("RECEIVED") // RECEIVED→IN_PROGRESS→RESOLVED→CLOSED / CANCELED
  assigneeEmpId String?  @map("assignee_emp_id") @db.Uuid
  resolution    String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orgUnitId])
  @@map("support_ticket")
}

// ── MKT-01: 마케팅 캠페인 (문자/알림톡 대량발송 — 세그먼트 타겟) ──
model Campaign {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  channel        String    @default("SMS") // SMS | ALIMTALK
  message        String
  targetGrade    String?   @map("target_grade") // null=전체 고객(전화 보유)
  status         String    @default("DRAFT") // DRAFT | SENT
  recipientCount Int       @default(0) @map("recipient_count")
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("campaign")
}

// ── HR-01: 인센티브/패널티 정책 (설정 기반 룰 — 화면에서 등록, 실적으로 자동계산) ──
model HrPolicy {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  kind       String   @default("INCENTIVE") // INCENTIVE(수당) | PENALTY(패널티)
  targetType String   @map("target_type") // EMPLOYEE | BRANCH
  metric     String // CONTRACT_REVENUE | CONTRACT_COUNT | PAID_REVENUE | DONE_COUNT | AS_COUNT
  calcType   String   @map("calc_type") // RATE | FIXED_PER_UNIT
  value      Decimal  @db.Decimal(14, 4) // rate(0.0150) 또는 단위당 정액(30000)
  orgScopeId String?  @map("org_scope_id") @db.Uuid // 특정 지점에만 적용(선택)
  isActive   Boolean  @default(true) @map("is_active")
  priority   Int      @default(100)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("hr_policy")
}

// ── CAL-01: 캘린더 — 자체 일정(개인/조직) + 구글 캘린더 양방향 동기화 ──

// 자체 캘린더 일정. visibility=PRIVATE(개인) | ORG(소속 조직 공유).
// 구글 연동 시 googleEventId로 원격 이벤트와 1:1 매핑된다.
model CalendarEvent {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  description String?
  date        DateTime  @db.Date // 일정 시작 날짜
  endDate     DateTime? @map("end_date") @db.Date // 여러 날 일정의 마지막 날(포함). null이면 하루짜리
  startTime   String?   @map("start_time") // "HH:mm" — null이면 종일
  endTime     String?   @map("end_time") // "HH:mm"
  color       String    @default("#FF3B30") // 캘린더 색상(EVENT_COLORS 키)
  location    String?

  visibility String @default("PRIVATE") // PRIVATE(개인) | ORG(조직 공유)

  ownerUserId String  @map("owner_user_id") @db.Uuid
  owner       AppUser @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  orgUnitId String?  @map("org_unit_id") @db.Uuid // visibility=ORG일 때 공유 대상 조직
  orgUnit   OrgUnit? @relation(fields: [orgUnitId], references: [id])

  // 구글 캘린더 동기화 상태
  source        String    @default("LOCAL") // LOCAL(자체 생성) | GOOGLE(구글에서 가져옴)
  googleEventId String?   @map("google_event_id")
  syncedAt      DateTime? @map("synced_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([ownerUserId, googleEventId]) // 같은 구글 이벤트 중복 임포트 방지
  @@index([date])
  @@index([ownerUserId, date])
  @@index([orgUnitId, date])
  @@map("calendar_event")
}

// 사용자별 구글 계정 연결(OAuth 토큰). 앱 단위 Client ID/Secret은 환경변수,
// 실제 캘린더 접근 권한은 사용자가 개인 구글 계정으로 각자 동의해 발급받는다.
model GoogleCalendarLink {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @unique @map("user_id") @db.Uuid
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  googleEmail  String    @map("google_email")
  accessToken  String    @map("access_token")
  refreshToken String?   @map("refresh_token") // 최초 동의 시에만 내려옴 — 보관 필수
  tokenExpiry  DateTime? @map("token_expiry") @db.Timestamptz(6)
  scope        String?

  calendarId  String    @default("primary") @map("calendar_id")
  syncEnabled Boolean   @default(true) @map("sync_enabled")
  syncToken   String?   @map("sync_token") // 구글 증분 동기화 토큰
  lastSyncAt  DateTime? @map("last_sync_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("google_calendar_link")
}
