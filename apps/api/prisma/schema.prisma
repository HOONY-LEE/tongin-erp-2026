// 통인 ERP — Prisma 스키마 (초기 핵심 마스터 4종)
// 전체 설계는 루트 DB스키마-설계.md 참조. 여기는 FND-01 스켈레톤용 시드 모델.
// 명명: 모델은 PascalCase, 실제 테이블/컬럼은 snake_case(@@map/@map).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OrgUnit {
  id        String     @id @default(uuid()) @db.Uuid
  parentId  String?    @map("parent_id") @db.Uuid
  parent    OrgUnit?   @relation("OrgUnitParent", fields: [parentId], references: [id])
  children  OrgUnit[]  @relation("OrgUnitParent")
  type      String // GROUP | COMPANY | BRANCH | PARTNER
  code      String     @unique
  name      String
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  employees Employee[]
  customers Customer[]
  userRoleScopes UserRole[] @relation("UserRoleOrgScope")

  @@map("org_unit")
}

model CommonCode {
  id        String  @id @default(uuid()) @db.Uuid
  codeGroup String  @map("code_group")
  code      String
  name      String
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  @@unique([codeGroup, code])
  @@map("common_code")
}

model Employee {
  id        String   @id @default(uuid()) @db.Uuid
  orgUnitId String   @map("org_unit_id") @db.Uuid
  orgUnit   OrgUnit  @relation(fields: [orgUnitId], references: [id])
  empNo     String?  @unique @map("emp_no")
  name      String
  phone     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  appUsers  AppUser[]

  @@map("employee")
}

model Customer {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  phonePrimary String?  @map("phone_primary")
  legacyId     String?  @map("legacy_id") // 레거시 memID 보존(마이그레이션 crosswalk)
  grade        String?
  status       String?
  ownerOrgId   String?  @map("owner_org_id") @db.Uuid
  ownerOrg     OrgUnit? @relation(fields: [ownerOrgId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phonePrimary])
  @@map("customer")
}

// ── FND-03: 인증 + RBAC (역할 × 기능 × 데이터범위 × 조직) ──
// DB스키마-설계.md §2 기반 + 설계노트 1-B(에이전트=1급 주체) 반영.

model AppUser {
  id            String     @id @default(uuid()) @db.Uuid
  employeeId    String?    @map("employee_id") @db.Uuid // 직원 계정(외부인·에이전트는 NULL)
  employee      Employee?  @relation(fields: [employeeId], references: [id])
  loginId       String     @unique @map("login_id")
  passwordHash  String?    @map("password_hash") // 에이전트/워크플로우는 NULL(토큰 인증)
  principalType String     @default("HUMAN") @map("principal_type") // HUMAN | AGENT | WORKFLOW (1-B)
  isExternal    Boolean    @default(false) @map("is_external")
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  userRoles     UserRole[]
  apiTokens     ApiToken[]

  @@map("app_user")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  rolePerms   RolePermission[]
  userRoles   UserRole[]

  @@map("role")
}

model Permission {
  id        String           @id @default(uuid()) @db.Uuid
  code      String           @unique // 예: ORG_UNIT.READ, CONTRACT.APPROVE
  name      String
  rolePerms RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String   @map("role_id") @db.Uuid
  role       Role     @relation(fields: [roleId], references: [id])
  orgScopeId String?  @map("org_scope_id") @db.Uuid // 이 조직(+하위)만
  orgScope   OrgUnit? @relation("UserRoleOrgScope", fields: [orgScopeId], references: [id])
  dataScope  String   @default("OWN") @map("data_scope") // OWN | ORG | ALL

  @@unique([userId, roleId, orgScopeId])
  @@map("user_role")
}

// 에이전트/워크플로우(및 PAT) 스코프 토큰 — 사람과 동일 RBAC + 권한 부분집합·만료·폐기 (1-B)
model ApiToken {
  id          String    @id @default(uuid()) @db.Uuid
  principalId String    @map("principal_id") @db.Uuid
  principal   AppUser   @relation(fields: [principalId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String    @unique @map("token_hash") // 평문 토큰은 발급 시 1회만 노출
  scopes      String[]  @default([]) // 허용 permission code 부분집합('*'=주체 권한 전체)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("api_token")
}
