// 통인 ERP — Prisma 스키마 (초기 핵심 마스터 4종)
// 전체 설계는 루트 DB스키마-설계.md 참조. 여기는 FND-01 스켈레톤용 시드 모델.
// 명명: 모델은 PascalCase, 실제 테이블/컬럼은 snake_case(@@map/@map).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OrgUnit {
  id              String     @id @default(uuid()) @db.Uuid
  parentId        String?    @map("parent_id") @db.Uuid
  parent          OrgUnit?   @relation("OrgUnitParent", fields: [parentId], references: [id])
  children        OrgUnit[]  @relation("OrgUnitParent")
  type            String // GROUP | COMPANY | BRANCH | PARTNER
  code            String     @unique
  name            String
  // 위치 — 지점은 대시보드 지도에 점으로 찍힌다. 주소 검색(카카오)으로 좌표까지 채운다
  zipcode         String?
  addr            String?
  addrDetail      String?    @map("addr_detail")
  sido            String?
  sigungu         String?
  lat             Float?
  lng             Float?
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  employees       Employee[]
  customers       Customer[]
  userRoleScopes  UserRole[] @relation("UserRoleOrgScope")
  brandedProducts Product[]  @relation("ProductBrand")
  leads           Lead[]

  estimates       Estimate[]
  contracts       Contract[]
  workOrders      WorkOrder[]
  commissionRules CommissionRule[] @relation("CommissionRuleOrg")
  invoices        Invoice[]        @relation("InvoiceOrg")
  materialOrders  MaterialOrder[]
  calendarEvents  CalendarEvent[]

  @@map("org_unit")
}

model CommonCode {
  id        String  @id @default(uuid()) @db.Uuid
  codeGroup String  @map("code_group")
  code      String
  name      String
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  @@unique([codeGroup, code])
  @@map("common_code")
}

model Employee {
  id         String    @id @default(uuid()) @db.Uuid
  orgUnitId  String    @map("org_unit_id") @db.Uuid
  orgUnit    OrgUnit   @relation(fields: [orgUnitId], references: [id])
  empNo      String?   @unique @map("emp_no") // 사번 — 비우면 입사연도 4자리+일련번호 4자리로 자동(20260001)
  name       String
  positionId String?   @map("position_id") @db.Uuid // 직책·직급(표시·인사용, 권한을 주지 않는다)
  position   Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  phone      String?
  hireDate   DateTime? @map("hire_date") @db.Date // 입사일 — 사번(입사연도+일련번호)의 기준
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  appUsers   AppUser[]
  ownedLeads Lead[]

  estimatorEstimates Estimate[]
  assignments        WorkAssignment[]
  campaignRecipients CampaignRecipient[]
  agentShares        AgentBlueprintShare[]

  @@map("employee")
}

model Customer {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  phonePrimary String?    @map("phone_primary")
  legacyId     String?    @map("legacy_id") // 레거시 memID 보존(마이그레이션 crosswalk)
  grade        String?
  status       String?
  zipcode      String? // 카카오/다음 우편번호
  addr         String? // 도로명주소
  addrDetail   String?    @map("addr_detail")
  sido         String?
  sigungu      String?
  lat          Float?
  lng          Float?
  ownerOrgId   String?    @map("owner_org_id") @db.Uuid
  ownerOrg     OrgUnit?   @relation(fields: [ownerOrgId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  leads        Lead[]
  estimates    Estimate[]
  contracts    Contract[]

  @@index([phonePrimary])
  @@map("customer")
}

// ── FND-03: 인증 + RBAC (역할 × 기능 × 데이터범위 × 조직) ──
// DB스키마-설계.md §2 기반 + 설계노트 1-B(에이전트=1급 주체) 반영.

model AppUser {
  id            String     @id @default(uuid()) @db.Uuid
  employeeId    String?    @map("employee_id") @db.Uuid // 직원 계정(외부인·에이전트는 NULL)
  employee      Employee?  @relation(fields: [employeeId], references: [id])
  loginId       String     @unique @map("login_id")
  passwordHash  String?    @map("password_hash") // 에이전트/워크플로우는 NULL(토큰 인증)
  principalType String     @default("HUMAN") @map("principal_type") // HUMAN | AGENT | WORKFLOW (1-B)
  isExternal    Boolean    @default(false) @map("is_external")
  isActive      Boolean    @default(true) @map("is_active")
  partnerId     String?    @map("partner_id") @db.Uuid // 외부 전속/제휴 사용자 소속(데이터범위 스코프, OPS-04)
  partner       Partner?   @relation(fields: [partnerId], references: [id])
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  userRoles     UserRole[]
  apiTokens     ApiToken[]

  calendarEvents     CalendarEvent[]
  googleCalendarLink GoogleCalendarLink?
  aiConversations    AiConversation[]
  workPhotos         WorkPhoto[]

  @@map("app_user")
}

// 권한 그룹(=역할). 메뉴×CRUD 권한 묶음 — 직책(Position)과는 별개 축이다.
model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false) @map("is_system") // 시드 기본 그룹: 삭제 불가(권한은 고칠 수 있음)
  fieldApp    Boolean          @default(false) @map("field_app") // 로그인 시 현장앱으로 진입
  sortOrder   Int              @default(100) @map("sort_order")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  rolePerms   RolePermission[]
  userRoles   UserRole[]
  positions   Position[]

  @@map("role")
}

// 직책·직급(회장·대표·이사·부장…) — 관리자가 자유롭게 정의. 권한은 주지 않고,
// 계정을 만들 때 기본 권한 그룹을 추천하는 데만 쓴다(defaultRole).
model Position {
  id            String     @id @default(uuid()) @db.Uuid
  name          String     @unique
  sortOrder     Int        @default(100) @map("sort_order")
  isActive      Boolean    @default(true) @map("is_active")
  defaultRoleId String?    @map("default_role_id") @db.Uuid
  defaultRole   Role?      @relation(fields: [defaultRoleId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  employees     Employee[]

  @@map("position")
}

model Permission {
  id        String           @id @default(uuid()) @db.Uuid
  code      String           @unique // 예: ORG_UNIT.READ, CONTRACT.APPROVE
  name      String
  rolePerms RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String   @map("role_id") @db.Uuid
  role       Role     @relation(fields: [roleId], references: [id])
  orgScopeId String?  @map("org_scope_id") @db.Uuid // 이 조직(+하위)만
  orgScope   OrgUnit? @relation("UserRoleOrgScope", fields: [orgScopeId], references: [id])
  dataScope  String   @default("OWN") @map("data_scope") // OWN | ORG | ALL

  @@unique([userId, roleId, orgScopeId])
  @@map("user_role")
}

// 에이전트/워크플로우(및 PAT) 스코프 토큰 — 사람과 동일 RBAC + 권한 부분집합·만료·폐기 (1-B)
model ApiToken {
  id          String    @id @default(uuid()) @db.Uuid
  principalId String    @map("principal_id") @db.Uuid
  principal   AppUser   @relation(fields: [principalId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String    @unique @map("token_hash") // 평문 토큰은 발급 시 1회만 노출
  scopes      String[]  @default([]) // 허용 permission code 부분집합('*'=주체 권한 전체)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("api_token")
}

// ── FND-09: 서비스 카탈로그 4엔티티 (부록 D-2) + 거래처(Partner) ──
// 레거시 Item 1테이블에 섞여있던 4개념을 분리: 판매상품/품목사전/옵션/가격조건.

model Partner {
  id              String           @id @default(uuid()) @db.Uuid
  type            String // AFFILIATE(제휴) | OUTSOURCE(전속) | B2B_CLIENT
  code            String           @unique
  name            String
  phone           String? // 담당자 연락처 — 전속 작업 배정 알림톡 수신처
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  priceConditions PriceCondition[]
  leads           Lead[]

  workOrders WorkOrder[]
  invoices   Invoice[]
  appUsers   AppUser[]

  @@map("partner")
}

// A. 판매상품(SKU): 고객이 사는 것, 견적/계약 라인에 오름
// 상품구성 — 가정이사·기업이전 등 견적서에 대표로 보이는 묶음. 실제로 파는 건 구성 상품(product_addon → addon_service)
model Product {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  name          String
  category      String? // common_code: PRODUCT_CATEGORY (가정이사/사무실이사/보관…)
  serviceLine   String   @map("service_line") // common_code: SERVICE_LINE
  pricingMethod String   @map("pricing_method") // CBM | COST_PLUS | FLAT | PYEONG
  basePrice     Decimal? @map("base_price") @db.Decimal(14, 2) // 기본(디폴트) 가격
  brandOrgId    String?  @map("brand_org_id") @db.Uuid
  brandOrg      OrgUnit? @relation("ProductBrand", fields: [brandOrgId], references: [id])
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  estimates Estimate[]
  addons    ProductAddon[]

  @@map("product")
}

// 상품 ↔ 옵션(부가서비스) 연결 (상품별 제공 옵션). 가격 override 가능.
model ProductAddon {
  productId      String       @map("product_id") @db.Uuid
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  addonServiceId String       @map("addon_service_id") @db.Uuid
  addon          AddonService @relation(fields: [addonServiceId], references: [id], onDelete: Cascade)
  priceOverride  Decimal?     @map("price_override") @db.Decimal(14, 2) // 이 구성에서의 단가(없으면 상품 기본가). 이사물량이면 CBM·톤당 단가
  role           String       @default("OPTIONAL") // REQUIRED 필수 | DEFAULT 기본선택 | OPTIONAL 선택
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([productId, addonServiceId])
  @@map("product_addon")
}

// B. CBM 품목사전: 짐량 측정용 표준 사전 (단일 표준·중복방지)
// 이사물품 사전 — 견적 물품정보에서 고르는 물품. 물품은 하나이고, 방(RoomTemplate)은 자주 쓰는
// 물품을 모아 둔 틀일 뿐이다(안방 컴퓨터와 서재 컴퓨터는 같은 물품을 가리킨다).
model CbmItem {
  id            String             @id @default(uuid()) @db.Uuid
  code          String             @unique // 서버 발급(ITM-0001)
  category      String // 분류(침실/거실/주방/가전 …) — 관리용
  name          String             @unique
  nameEng       String?            @map("name_eng") // 견적서 영문 병기
  cbm           Decimal?           @db.Decimal(8, 2) // 기본 부피 — 없으면 견적 때 직접 입력
  ton           Decimal?           @db.Decimal(8, 2) // 기본 무게(톤 견적용)
  sortOrder     Int                @default(0) @map("sort_order")
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  estimateLines EstimateLine[]
  rooms         RoomTemplateItem[]

  @@map("cbm_item")
}

// 방 틀 — 견적 물품정보에 기본으로 펼쳐 둘 방과, 그 방에 자주 들어가는 물품 목록
model RoomTemplate {
  id         String             @id @default(uuid()) @db.Uuid
  code       String             @unique // 견적 방(estimate_zone.room_key)이 가리키는 키. 기본 방은 MASTER 등, 새 방은 ROOM-0001
  name       String             @unique
  nameEng    String?            @map("name_eng")
  extraSlots Int                @default(2) @map("extra_slots") // 견적표에 둘 '기타' 칸 수(목록 밖 물품은 여기에 메모와 함께 적는다)
  sortOrder  Int                @default(0) @map("sort_order")
  isActive   Boolean            @default(true) @map("is_active")
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  items      RoomTemplateItem[]

  @@map("room_template")
}

model RoomTemplateItem {
  roomId    String       @map("room_id") @db.Uuid
  room      RoomTemplate @relation(fields: [roomId], references: [id], onDelete: Cascade)
  cbmItemId String       @map("cbm_item_id") @db.Uuid
  cbmItem   CbmItem      @relation(fields: [cbmItemId], references: [id], onDelete: Cascade)
  sortOrder Int          @default(0) @map("sort_order")

  @@id([roomId, cbmItemId])
  @@map("room_template_item")
}

// 처리방법 — 물품마다 고르는 처리(운반·폐기·하역·경유·방치·업체 …). 물량 집계 칸(bucket)을 정해 둔다
model HandlingMethod {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique // 견적 물품(estimate_line.handling)이 가리키는 키. 기본은 CARRY 등, 새 값은 HDL-0001
  name      String   @unique
  bucket    String // MOVING 이사물량 | TRANSIT 경유물량 | DISCARD 폐기물량 | EXCLUDED 물량 제외
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("handling_method")
}

// C. 옵션/부가서비스: 애드온 (분해설치·사다리차·보관…)
// 옵션(부가서비스) 카탈로그 — 견적 3단계(옵션선택)에 나오는 목록의 원본.
// 상품관리 '옵션' 탭에서 관리하고, 견적에는 이름·종류·금액을 스냅샷으로 담는다(EstimateAddon).
model AddonService {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique // 서버 발급(OPT-0001)
  name      String
  unit      String // EA | FLAT
  price     Decimal? @db.Decimal(14, 2) // 참고 기본가 — 견적 금액은 견적마다 입력
  groupCode String   @default("ETC") @map("group_code") // 견적 화면 묶음: LADDER | LIVING | ASSEMBLY | ETC
  variants  Json? // 종류 [{value,label}] — 입주청소 일반/프리미엄, 분해·설치/분해만/설치만 등
  hasDate   Boolean  @default(false) @map("has_date") // 서비스 요청일을 받는다
  hasNote   Boolean  @default(false) @map("has_note") // 내용을 적는다(기타·보관 등)
  kind      String   @default("SERVICE") // VOLUME 이사물량(물품정보로 견적) | SERVICE 일반 상품
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  products       ProductAddon[]
  estimateAddons EstimateAddon[]

  @@map("addon_service")
}

// ── FND-07: 이벤트(outbox) + 감사로그 ──
// 전표 원칙(모든 변경 불변기록) + AI 개방(이벤트 디스패치) 토대. 설계노트 1-A/1-B, DB스키마 §9.

model DomainEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type") // 예: org_unit
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type") // 예: org_unit.created
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)

  @@index([aggregateType, aggregateId])
  @@index([publishedAt])
  @@map("domain_event")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String   @map("entity_type") // 라우트 리소스(예: org-units)
  entityId    String?  @map("entity_id")
  action      String // CREATE | UPDATE | DELETE
  actorUserId String?  @map("actor_user_id") @db.Uuid
  method      String
  path        String
  statusCode  Int      @map("status_code")
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_log")
}

// D. 가격조건(제휴/프로모션): 상품 아님 → 거래처 + 조건 오버레이
model PriceCondition {
  id            String    @id @default(uuid()) @db.Uuid
  partnerId     String?   @map("partner_id") @db.Uuid
  partner       Partner?  @relation(fields: [partnerId], references: [id])
  name          String
  discountType  String    @map("discount_type") // RATE | AMOUNT | FIXED_PRICE
  discountValue Decimal   @map("discount_value") @db.Decimal(14, 2)
  validFrom     DateTime? @map("valid_from") @db.Date
  validTo       DateTime? @map("valid_to") @db.Date
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("price_condition")
}

// ── Phase 1: 리드(접수) — 이사 프로세스의 출발점 (DB스키마 §5) ──
model Lead {
  id             String      @id @default(uuid()) @db.Uuid
  leadNo         String      @unique @map("lead_no") // 접수번호 R...
  customerId     String?     @map("customer_id") @db.Uuid
  customer       Customer?   @relation(fields: [customerId], references: [id])
  orgUnitId      String      @map("org_unit_id") @db.Uuid // 담당 지점
  orgUnit        OrgUnit     @relation(fields: [orgUnitId], references: [id])
  ownerEmpId     String?     @map("owner_emp_id") @db.Uuid
  ownerEmp       Employee?   @relation(fields: [ownerEmpId], references: [id])
  partnerId      String?     @map("partner_id") @db.Uuid // 제휴/전속 출처
  partner        Partner?    @relation(fields: [partnerId], references: [id])
  source         String? // common_code: RECEIPT_PATH
  serviceLine    String?     @map("service_line")
  status         String      @default("RECEIVED") // 상태머신(shared LEAD_STATUS)
  fromZipcode    String?     @map("from_zipcode")
  fromAddr       String?     @map("from_addr") // 도로명주소(카카오/다음 우편번호)
  fromAddrDetail String?     @map("from_addr_detail") // 상세주소
  fromSido       String?     @map("from_sido")
  fromSigungu    String?     @map("from_sigungu")
  fromLat        Float?      @map("from_lat") // 위도(카카오 Local geocode)
  fromLng        Float?      @map("from_lng") // 경도
  toZipcode      String?     @map("to_zipcode")
  toAddr         String?     @map("to_addr")
  toAddrDetail   String?     @map("to_addr_detail")
  toSido         String?     @map("to_sido")
  toSigungu      String?     @map("to_sigungu")
  toLat          Float?      @map("to_lat")
  toLng          Float?      @map("to_lng")
  moveDate       DateTime?   @map("move_date") @db.Date
  visitDate      DateTime?   @map("visit_date") @db.Date
  expectedAmount Decimal?    @map("expected_amount") @db.Decimal(14, 2)
  attributes     Json?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime?   @updatedAt @map("updated_at") @db.Timestamptz(6)
  estimates      Estimate[]
  contracts      Contract[]
  workOrders     WorkOrder[]

  @@index([status])
  @@index([orgUnitId])
  @@map("lead")
}

// ── Phase 1: 견적 (부록 E·F) — 헤더 + 구역 + 품목라인 ──
model Estimate {
  id               String               @id @default(uuid()) @db.Uuid
  estimateNo       String               @unique @map("estimate_no")
  leadId           String               @map("lead_id") @db.Uuid
  lead             Lead                 @relation(fields: [leadId], references: [id])
  customerId       String               @map("customer_id") @db.Uuid
  customer         Customer             @relation(fields: [customerId], references: [id])
  orgUnitId        String               @map("org_unit_id") @db.Uuid
  orgUnit          OrgUnit              @relation(fields: [orgUnitId], references: [id])
  productId        String               @map("product_id") @db.Uuid
  product          Product              @relation(fields: [productId], references: [id])
  estimatorEmpId   String?              @map("estimator_emp_id") @db.Uuid
  estimator        Employee?            @relation(fields: [estimatorEmpId], references: [id])
  fromZipcode      String?              @map("from_zipcode")
  fromAddr         String?              @map("from_addr") // 도로명주소
  fromAddrDetail   String?              @map("from_addr_detail")
  fromSido         String?              @map("from_sido")
  fromSigungu      String?              @map("from_sigungu")
  fromLat          Float?               @map("from_lat")
  fromLng          Float?               @map("from_lng")
  fromPyeong       Int?                 @map("from_pyeong")
  fromAccess       String               @default("NONE") @map("from_access") // NONE|LADDER|ELEVATOR|STAIRS|ETC (shared ACCESS_METHODS)
  fromAccessNote   String?              @map("from_access_note") // 기타일 때 내용
  toZipcode        String?              @map("to_zipcode")
  toAddr           String?              @map("to_addr")
  toAddrDetail     String?              @map("to_addr_detail")
  toSido           String?              @map("to_sido")
  toSigungu        String?              @map("to_sigungu")
  toLat            Float?               @map("to_lat")
  toLng            Float?               @map("to_lng")
  toPyeong         Int?                 @map("to_pyeong")
  toAccess         String               @default("NONE") @map("to_access") // NONE|LADDER|ELEVATOR|STAIRS|ETC (shared ACCESS_METHODS)
  toAccessNote     String?              @map("to_access_note") // 기타일 때 내용
  totalCbm         Decimal              @default(0) @map("total_cbm") @db.Decimal(10, 2)
  totalTon         Decimal              @default(0) @map("total_ton") @db.Decimal(10, 2)
  volumeUnit       String               @default("CBM") @map("volume_unit") // CBM | TON — 이사물량을 무엇으로 견적하나
  // 출발지 → 도착지 거리(거리 할증 근거). 주소가 바뀌면 다시 계산한다
  distanceKm       Decimal?             @map("distance_km") @db.Decimal(8, 1)
  durationMin      Int?                 @map("duration_min") // 예상 소요(분) — 직선 추정이면 없음
  distanceSource   String?              @map("distance_source") // KAKAO 도로 | STRAIGHT 직선×1.3 추정 | NONE 좌표 없음
  optionsSavedAt   DateTime?            @map("options_saved_at") @db.Timestamptz(6) // 3단계를 한 번이라도 저장했나(기본선택 상품 미리 체크 여부)
  baseAmount       Decimal?             @map("base_amount") @db.Decimal(14, 2)
  totalAmount      Decimal?             @map("total_amount") @db.Decimal(14, 2)
  // 견적 금액 확정 — 현장 견적사원이 견적서를 발송하기 전에 정한다.
  moveAmount       Decimal?             @map("move_amount") @db.Decimal(14, 2) // 이사비용(옵션 제외)
  vatMode          String               @default("EXCLUDED") @map("vat_mode") // EXCLUDED | INCLUDED
  vatAmount        Decimal?             @map("vat_amount") @db.Decimal(14, 2) // 포함일 때 명시 금액
  depositAmount    Decimal?             @map("deposit_amount") @db.Decimal(14, 2) // 계약금
  balanceAmount    Decimal?             @map("balance_amount") @db.Decimal(14, 2) // 잔금
  workInstructions String?              @map("work_instructions")
  status           String               @default("DRAFT") // DRAFT | QUOTED
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  zones            EstimateZone[]
  lines            EstimateLine[]
  addons           EstimateAddon[]
  costLines        EstimateCostLine[]
  costBuildup      EstimateCostBuildup?
  contract         Contract?

  @@index([leadId])
  @@map("estimate")
}

// EST-04: 기업이전(B2B) 원가 적상식 (설계노트 F-3). 견적당 1개(1:1).
// 합계 = 재료비(costLines) + 차량비 + 노무비 + 기타
// 총용역원가 = 합계 + 공과잡비 + 일반관리비 + 이윤 (각 비율은 합계 기준) → 견적가
model EstimateCostBuildup {
  estimateId   String   @id @map("estimate_id") @db.Uuid
  estimate     Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  vehicleCost  Decimal  @default(0) @map("vehicle_cost") @db.Decimal(14, 2) // 차량비
  laborCost    Decimal  @default(0) @map("labor_cost") @db.Decimal(14, 2) // 노무비
  etcCost      Decimal  @default(0) @map("etc_cost") @db.Decimal(14, 2) // 기타
  overheadRate Decimal  @default(0) @map("overhead_rate") @db.Decimal(6, 4) // 공과잡비율(0~1)
  adminRate    Decimal  @default(0) @map("admin_rate") @db.Decimal(6, 4) // 일반관리비율
  profitRate   Decimal  @default(0) @map("profit_rate") @db.Decimal(6, 4) // 이윤율
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("estimate_cost_buildup")
}

// 견적에 선택된 옵션(부가서비스) — 카탈로그(AddonService)에서 골라 담는다.
// 카탈로그를 참조만 하지 않고 이름·단가를 함께 스냅샷하는 이유: 견적서는 발송 시점의
// 조건을 증빙하는 문서라, 나중에 카탈로그 가격이 바뀌어도 과거 견적 금액이 흔들리면 안 된다.
model EstimateAddon {
  id             String        @id @default(uuid()) @db.Uuid
  estimateId     String        @map("estimate_id") @db.Uuid
  estimate       Estimate      @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  addonServiceId String?       @map("addon_service_id") @db.Uuid // 자유 입력 항목(기타서비스)이면 null
  code           String? // 고른 옵션의 카탈로그 코드 스냅샷. 예전 자유 입력 행은 null
  variant        String? // 옵션 안의 종류(일반/프리미엄, 분해·설치 여부 등)
  serviceDate    DateTime?     @map("service_date") @db.Date // 서비스 요청일
  addonService   AddonService? @relation(fields: [addonServiceId], references: [id])
  name           String // 스냅샷(옵션명)
  qty            Decimal       @default(1) @db.Decimal(8, 2)
  unitPrice      Decimal       @default(0) @map("unit_price") @db.Decimal(14, 2)
  amount         Decimal       @default(0) @db.Decimal(14, 2) // qty × unitPrice
  memo           String? // 분해/설치 대상(일반장롱 등) 같은 세부를 적는다
  isExtra        Boolean       @default(false) @map("is_extra") // 상품 구성 밖에서 추가한 상품
  sortOrder      Int           @default(0) @map("sort_order")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([estimateId])
  @@map("estimate_addon")
}

model EstimateZone {
  id         String         @id @default(uuid()) @db.Uuid
  estimateId String         @map("estimate_id") @db.Uuid
  estimate   Estimate       @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  name       String // 안방/거실/사무실 등 (유연)
  roomKey    String?        @map("room_key") // 방 틀(room_template.code). 견적에서 직접 만든 방은 null
  sortOrder  Int            @default(0) @map("sort_order")
  lines      EstimateLine[]

  @@map("estimate_zone")
}

model EstimateLine {
  id          String        @id @default(uuid()) @db.Uuid
  estimateId  String        @map("estimate_id") @db.Uuid
  estimate    Estimate      @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  zoneId      String?       @map("zone_id") @db.Uuid
  zone        EstimateZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  cbmItemId   String?       @map("cbm_item_id") @db.Uuid
  cbmItem     CbmItem?      @relation(fields: [cbmItemId], references: [id])
  itemName    String        @map("item_name") // 스냅샷(품목명)
  itemNameEng String?       @map("item_name_eng") // 영문 품목명(견적서 병기용)
  qty         Decimal       @default(1) @db.Decimal(8, 2)
  cbm         Decimal       @default(0) @db.Decimal(8, 2) // 라인 합계 CBM (단위CBM×수량)
  ton         Decimal?      @db.Decimal(8, 2) // 톤 견적일 때 무게
  handling    String        @default("CARRY") // handling_method.code (운반/폐기/경유 …)
  memo        String?

  @@map("estimate_line")
}

// EST-03: 견적 재료비 라인 → 자재 소요/차감 연동 (설계노트 F-4)
// 흐름: 견적(재료비 산정) → 자재 소요량 → 자재·재고(MM) OUT 차감(전표) → 원가 반영.
model EstimateCostLine {
  id              String    @id @default(uuid()) @db.Uuid
  estimateId      String    @map("estimate_id") @db.Uuid
  estimate        Estimate  @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  materialId      String    @map("material_id") @db.Uuid
  material        Material  @relation(fields: [materialId], references: [id])
  qty             Int // 소요 수량(자재는 정수 단위 — 재고 수불과 일치)
  unitPrice       Decimal   @default(0) @map("unit_price") @db.Decimal(14, 2)
  totalPrice      Decimal   @default(0) @map("total_price") @db.Decimal(14, 2) // qty × unitPrice
  memo            String?
  status          String    @default("DRAFT") // DRAFT | DEDUCTED | CANCELED
  deductedAt      DateTime? @map("deducted_at") @db.Timestamptz(6)
  stockMovementId String?   @map("stock_movement_id") @db.Uuid // 차감 전표 추적
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([estimateId])
  @@map("estimate_cost_line")
}

// ── Phase 1: 계약 + 결제 (부록 E·11장) ──
model Contract {
  id                 String    @id @default(uuid()) @db.Uuid
  contractNo         String    @unique @map("contract_no")
  estimateId         String    @unique @map("estimate_id") @db.Uuid
  estimate           Estimate  @relation(fields: [estimateId], references: [id])
  leadId             String    @map("lead_id") @db.Uuid
  lead               Lead      @relation(fields: [leadId], references: [id])
  customerId         String    @map("customer_id") @db.Uuid
  customer           Customer  @relation(fields: [customerId], references: [id])
  orgUnitId          String    @map("org_unit_id") @db.Uuid
  orgUnit            OrgUnit   @relation(fields: [orgUnitId], references: [id])
  contractDate       DateTime? @map("contract_date") @db.Date
  totalAmount        Decimal   @map("total_amount") @db.Decimal(14, 2)
  depositRatio       Decimal   @default(0.1) @map("deposit_ratio") @db.Decimal(5, 2)
  depositAmount      Decimal   @map("deposit_amount") @db.Decimal(14, 2)
  balanceAmount      Decimal   @map("balance_amount") @db.Decimal(14, 2)
  status             String    @default("DRAFT") // DRAFT | SIGNED | CANCELED
  snapshot           Json? // 서명 시점 동결 데이터(E-0)
  signedAt           DateTime? @map("signed_at") @db.Timestamptz(6)
  esignRef           String?   @map("esign_ref") // 전자계약 업체 참조(스텁)
  // 고객에게 보낸 견적서 링크로 고객이 직접 서명한다(공개 페이지 /s/:token)
  signToken          String?   @unique @map("sign_token")
  signTokenExpiresAt DateTime? @map("sign_token_expires_at") @db.Timestamptz(6)
  signatureImage     String?   @map("signature_image") // 서명 그림(PNG data URL)
  signerName         String?   @map("signer_name")
  sentAt             DateTime? @map("sent_at") @db.Timestamptz(6) // 고객에게 마지막으로 보낸 시각
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  payments           Payment[]
  invoices           Invoice[]

  workOrder WorkOrder?

  @@map("contract")
}

model Payment {
  id             String    @id @default(uuid()) @db.Uuid
  contractId     String    @map("contract_id") @db.Uuid
  contract       Contract  @relation(fields: [contractId], references: [id])
  kind           String // DEPOSIT(계약금) | BALANCE(잔금)
  method         String    @default("VIRTUAL_ACCOUNT") // VIRTUAL_ACCOUNT | CARD | TRANSFER | CASH
  amount         Decimal   @db.Decimal(14, 2)
  status         String    @default("PENDING") // PENDING | PAID | CANCELED
  pgProvider     String    @default("TOSS") @map("pg_provider") // TOSS(가상계좌 자동확인) | MANUAL(고정 계좌)
  pgRef          String?   @map("pg_ref")
  virtualAccount String?   @map("virtual_account")
  pgSecret       String?   @map("pg_secret") // 토스 웹훅 진위 확인 값
  dueAt          DateTime? @map("due_at") @db.Timestamptz(6) // 입금 기한
  paidAt         DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([contractId])
  @@map("payment")
}

// SET-03: 전속/B2B 청구·수금 (설계노트 D-3). 거래처(전속/B2B) 대상 청구서 + 수금 기록.
model Invoice {
  id         String           @id @default(uuid()) @db.Uuid
  invoiceNo  String           @unique @map("invoice_no")
  partnerId  String           @map("partner_id") @db.Uuid
  partner    Partner          @relation(fields: [partnerId], references: [id])
  orgUnitId  String?          @map("org_unit_id") @db.Uuid // 담당 지점(실적 귀속). 발행은 본사만
  orgUnit    OrgUnit?         @relation("InvoiceOrg", fields: [orgUnitId], references: [id])
  contractId String?          @map("contract_id") @db.Uuid // 계약에서 자동 생성된 경우 원본 계약
  contract   Contract?        @relation(fields: [contractId], references: [id])
  title      String
  amount     Decimal          @db.Decimal(14, 2) // 청구액
  status     String           @default("DRAFT") // DRAFT | ISSUED | COLLECTED | CANCELED
  issuedAt   DateTime?        @map("issued_at") @db.Timestamptz(6)
  dueDate    DateTime?        @map("due_date") @db.Date
  memo       String?
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  receipts   InvoiceReceipt[]

  @@index([partnerId])
  @@index([orgUnitId])
  @@index([contractId])
  @@map("invoice")
}

// 수금 기록(청구서별 입금). 합계가 청구액 이상이면 COLLECTED.
model InvoiceReceipt {
  id         String   @id @default(uuid()) @db.Uuid
  invoiceId  String   @map("invoice_id") @db.Uuid
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(14, 2)
  method     String   @default("TRANSFER") // TRANSFER | CASH | CARD
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  memo       String?

  @@index([invoiceId])
  @@map("invoice_receipt")
}

// SET-02: 지점 정산 수수료 규칙 (권한=데이터). 지점×서비스라인×출처 → 정률/정액, 우선순위 매칭.
model CommissionRule {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  orgUnitId   String?  @map("org_unit_id") @db.Uuid // 특정 지점(null=전체)
  orgUnit     OrgUnit? @relation("CommissionRuleOrg", fields: [orgUnitId], references: [id])
  serviceLine String?  @map("service_line") // 특정 서비스라인(null=전체)
  source      String? // 특정 출처(접수경로, null=전체)
  calcType    String   @map("calc_type") // RATE | FIXED
  rate        Decimal? @db.Decimal(6, 4) // RATE: 0~1
  fixedAmount Decimal? @map("fixed_amount") @db.Decimal(14, 2) // FIXED: 건당 정액
  priority    Int      @default(0) // 높을수록 우선
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("commission_rule")
}

// ── Phase 1: 작업오더(서비스오더) + 배정 — 작업토스 이후 (부록 D-3) ──
model WorkOrder {
  id            String           @id @default(uuid()) @db.Uuid
  workNo        String           @unique @map("work_no")
  contractId    String           @unique @map("contract_id") @db.Uuid
  contract      Contract         @relation(fields: [contractId], references: [id])
  leadId        String           @map("lead_id") @db.Uuid
  lead          Lead             @relation(fields: [leadId], references: [id])
  orgUnitId     String           @map("org_unit_id") @db.Uuid // 작업 수행 지점
  orgUnit       OrgUnit          @relation(fields: [orgUnitId], references: [id])
  partnerId     String?          @map("partner_id") @db.Uuid // 전속 외주 시
  partner       Partner?         @relation(fields: [partnerId], references: [id])
  scheduledDate DateTime?        @map("scheduled_date") @db.Date
  status        String           @default("ASSIGNED") // ASSIGNED | IN_PROGRESS | DONE | CANCELED
  billedCost    Decimal?         @map("billed_cost") @db.Decimal(14, 2) // 전속 청구비용(원가)=마진 추적
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  assignments   WorkAssignment[]
  photos        WorkPhoto[]

  @@map("work_order")
}

/// 현장 작업 사진(작업 전·후, 파손·하자) — 데모 규모라 내용은 DB(bytea)에 둔다. 운영 전 R2/S3로 옮길 것
model WorkPhoto {
  id               String    @id @default(uuid()) @db.Uuid
  workOrderId      String    @map("work_order_id") @db.Uuid
  workOrder        WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  kind             String // BEFORE(작업 전) | AFTER(작업 후) | DAMAGE(파손·하자) | ETC(기타)
  caption          String?
  mediaType        String    @map("media_type")
  size             Int
  width            Int?
  height           Int?
  bytes            Bytes
  uploadedByUserId String    @map("uploaded_by_user_id") @db.Uuid
  uploadedBy       AppUser   @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([workOrderId, createdAt])
  @@map("work_photo")
}

model WorkAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  workOrderId  String    @map("work_order_id") @db.Uuid
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  employeeId   String?   @map("employee_id") @db.Uuid
  employee     Employee? @relation(fields: [employeeId], references: [id])
  resourceType String    @map("resource_type") // CREW | VEHICLE
  resourceRef  String?   @map("resource_ref") // 차량번호/외부인력명 등
  scheduledAt  DateTime? @map("scheduled_at") @db.Timestamptz(6)

  @@map("work_assignment")
}

// ── INT-01: 알림톡/SMS 발송 기록 (이벤트 구독 발송, 스텁) ──
model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  channel   String   @default("ALIMTALK") // ALIMTALK | SMS
  eventType String   @map("event_type")
  recipient String? // 수신자(고객 연락처 등)
  message   String
  status    String   @default("SENT") // SENT | FAILED | SKIPPED(발송사 미연결로 실제 발송 안 함)
  payload   Json?
  sentAt    DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  @@index([eventType])
  @@map("notification")
}

// ── MM-01: 자재·재고 (자재마스터 + 입출고 수불 → 현재고는 수불 합산) ──
model Material {
  id                String              @id @default(uuid()) @db.Uuid
  code              String              @unique
  name              String
  category          String? // common_code: MATERIAL_CATEGORY (박스/포장지/유니폼…)
  unit              String              @default("EA") // EA | SET | ROLL | BOX
  safetyStock       Int                 @default(0) @map("safety_stock") // 안전재고(미만 시 경고)
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  movements         StockMovement[]
  estimateCostLines EstimateCostLine[]
  orderLines        MaterialOrderLine[]

  @@map("material")
}

// MM-02: 가맹점 발주 (지점이 본사에 박스·포장지·유니폼 발주 → 출고 시 본사 재고 OUT)
model MaterialOrder {
  id        String              @id @default(uuid()) @db.Uuid
  orderNo   String              @unique @map("order_no")
  orgUnitId String              @map("org_unit_id") @db.Uuid // 발주 지점
  orgUnit   OrgUnit             @relation(fields: [orgUnitId], references: [id])
  status    String              @default("REQUESTED") // REQUESTED | APPROVED | SHIPPED | CANCELED
  note      String?
  shippedAt DateTime?           @map("shipped_at") @db.Timestamptz(6)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  lines     MaterialOrderLine[]

  @@index([orgUnitId])
  @@map("material_order")
}

model MaterialOrderLine {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String        @map("order_id") @db.Uuid
  order           MaterialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  materialId      String        @map("material_id") @db.Uuid
  material        Material      @relation(fields: [materialId], references: [id])
  qty             Int
  stockMovementId String?       @map("stock_movement_id") @db.Uuid // 출고 전표 추적

  @@index([orderId])
  @@map("material_order_line")
}

model StockMovement {
  id         String   @id @default(uuid()) @db.Uuid
  materialId String   @map("material_id") @db.Uuid
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  orgUnitId  String?  @map("org_unit_id") @db.Uuid // 창고/지점(선택)
  type       String // IN(입고) | OUT(출고) | ADJUST(조정)
  qtyDelta   Int      @map("qty_delta") // 부호 포함: IN +, OUT -, ADJUST ±
  reason     String?
  refType    String?  @map("ref_type") // 연계 출처(발주/작업 등)
  refId      String?  @map("ref_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([materialId])
  @@map("stock_movement")
}

// ── CAT-01: 리빙·케어 서비스 주문 (이사 CBM 견적과 별개의 경량 서비스 주문) ──
model ServiceOrder {
  id            String    @id @default(uuid()) @db.Uuid
  orderNo       String    @unique @map("order_no")
  serviceLine   String    @map("service_line") // LIVING | CARE (홈케어/새집증후군/청소/엔딩케어)
  productId     String?   @map("product_id") @db.Uuid // 서비스 상품(scalar; 이름은 마스터에서 조회)
  customerId    String?   @map("customer_id") @db.Uuid
  orgUnitId     String    @map("org_unit_id") @db.Uuid // 담당 지점(데이터범위 스코프)
  scheduledDate DateTime? @map("scheduled_date") @db.Date
  address       String?
  amount        Decimal?  @db.Decimal(14, 2)
  note          String?
  status        String    @default("REQUESTED") // REQUESTED→SCHEDULED→DONE / CANCELED
  assignedEmpId String?   @map("assigned_emp_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orgUnitId])
  @@map("service_order")
}

// ── AS-01: CS·AS 접수/처리 (상담·불만=CS, 하자보수=AS) ──
model SupportTicket {
  id            String   @id @default(uuid()) @db.Uuid
  ticketNo      String   @unique @map("ticket_no")
  kind          String // CS | AS
  customerId    String?  @map("customer_id") @db.Uuid
  contractId    String?  @map("contract_id") @db.Uuid // AS는 원계약 연결
  orgUnitId     String   @map("org_unit_id") @db.Uuid // 담당 지점(데이터범위 스코프)
  channel       String? // PHONE | EMAIL | KAKAO | VISIT
  subject       String
  content       String?
  priority      String   @default("NORMAL") // LOW | NORMAL | HIGH
  status        String   @default("RECEIVED") // RECEIVED→IN_PROGRESS→RESOLVED→CLOSED / CANCELED
  assigneeEmpId String?  @map("assignee_emp_id") @db.Uuid
  resolution    String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orgUnitId])
  @@map("support_ticket")
}

// ── MKT-01: 마케팅 캠페인 (문자/알림톡 대량발송 — 세그먼트 타겟) ──
// 캠페인 — 고객을 골라(필터 + 개별 선택) 문자·알림톡을 보낸다. 받는 사람은 CampaignRecipient에 건별로 남는다.
model Campaign {
  id             String              @id @default(uuid()) @db.Uuid
  name           String
  channel        String              @default("SMS") // SMS | ALIMTALK
  message        String // 본문. {고객명}은 받는 사람마다 이름으로 바뀐다
  title          String? // 장문(LMS) 제목 · 알림톡 강조 제목
  isAd           Boolean             @default(false) @map("is_ad") // 광고성 — 본문 앞 (광고), 끝에 수신거부 문구
  optOutText     String?             @map("opt_out_text") // 무료수신거부 안내(광고일 때 본문 끝에 붙는다)
  templateCode   String?             @map("template_code") // 알림톡 템플릿 코드(카카오 검수 완료된 것)
  buttons        Json? // 알림톡 버튼 [{name,url}]
  fallbackSms    Boolean             @default(true) @map("fallback_sms") // 알림톡 실패 시 문자로 대체 발송
  filters        Json? // 대상 고를 때 쓴 조건(기록용)
  targetGrade    String?             @map("target_grade") // (예전 방식) 등급 일괄 대상
  status         String              @default("DRAFT") // DRAFT | SCHEDULED | SENDING | SENT | CANCELED
  scheduledAt    DateTime?           @map("scheduled_at") @db.Timestamptz(6) // 예약 발송 시각
  recipientCount Int                 @default(0) @map("recipient_count")
  sentCount      Int                 @default(0) @map("sent_count")
  failedCount    Int                 @default(0) @map("failed_count")
  sentAt         DateTime?           @map("sent_at") @db.Timestamptz(6)
  createdBy      String?             @map("created_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime?           @updatedAt @map("updated_at") @db.Timestamptz(6)
  recipients     CampaignRecipient[]

  @@map("campaign")
}

/// 캠페인 받는 사람 — 고를 때의 이름·번호를 남기고, 건별 발송 결과를 기록한다
model CampaignRecipient {
  id         String    @id @default(uuid()) @db.Uuid
  campaignId String    @map("campaign_id") @db.Uuid
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// 고객이면 고객 id. 직원·직접 입력(시연 번호)이면 비어 있다
  customerId String?   @map("customer_id") @db.Uuid
  /// 직원이면 직원 id(직원이 지워져도 발송 기록은 남는다)
  employeeId String?   @map("employee_id") @db.Uuid
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  name       String
  phone      String
  status     String    @default("PENDING") // PENDING | SENT | FAILED
  reason     String? // 실패 사유
  sentAt     DateTime? @map("sent_at") @db.Timestamptz(6)

  @@unique([campaignId, customerId])
  @@unique([campaignId, employeeId])
  @@index([customerId])
  @@index([employeeId])
  @@map("campaign_recipient")
}

// ── HR-01: 인센티브/패널티 정책 (설정 기반 룰 — 화면에서 등록, 실적으로 자동계산) ──
model HrPolicy {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  kind       String   @default("INCENTIVE") // INCENTIVE(수당) | PENALTY(패널티)
  targetType String   @map("target_type") // EMPLOYEE | BRANCH
  metric     String // CONTRACT_REVENUE | CONTRACT_COUNT | PAID_REVENUE | DONE_COUNT | AS_COUNT
  calcType   String   @map("calc_type") // RATE | FIXED_PER_UNIT
  value      Decimal  @db.Decimal(14, 4) // rate(0.0150) 또는 단위당 정액(30000)
  orgScopeId String?  @map("org_scope_id") @db.Uuid // 특정 지점에만 적용(선택)
  isActive   Boolean  @default(true) @map("is_active")
  priority   Int      @default(100)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("hr_policy")
}

// ── CAL-01: 캘린더 — 자체 일정(개인/조직) + 구글 캘린더 양방향 동기화 ──

// 자체 캘린더 일정. visibility=PRIVATE(개인) | ORG(소속 조직 공유).
// 구글 연동 시 googleEventId로 원격 이벤트와 1:1 매핑된다.
model CalendarEvent {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  description String?
  date        DateTime  @db.Date // 일정 시작 날짜
  endDate     DateTime? @map("end_date") @db.Date // 여러 날 일정의 마지막 날(포함). null이면 하루짜리
  startTime   String?   @map("start_time") // "HH:mm" — null이면 종일
  endTime     String?   @map("end_time") // "HH:mm"
  color       String    @default("#FF3B30") // 캘린더 색상(EVENT_COLORS 키)
  location    String?

  visibility String @default("PRIVATE") // PRIVATE(개인) | ORG(조직 공유)

  ownerUserId String  @map("owner_user_id") @db.Uuid
  owner       AppUser @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  orgUnitId String?  @map("org_unit_id") @db.Uuid // visibility=ORG일 때 공유 대상 조직
  orgUnit   OrgUnit? @relation(fields: [orgUnitId], references: [id])

  // 구글 캘린더 동기화 상태
  source        String    @default("LOCAL") // LOCAL(자체 생성) | GOOGLE(구글에서 가져옴)
  googleEventId String?   @map("google_event_id")
  syncedAt      DateTime? @map("synced_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([ownerUserId, googleEventId]) // 같은 구글 이벤트 중복 임포트 방지
  @@index([date])
  @@index([ownerUserId, date])
  @@index([orgUnitId, date])
  @@map("calendar_event")
}

// 사용자별 구글 계정 연결(OAuth 토큰). 앱 단위 Client ID/Secret은 환경변수,
// 실제 캘린더 접근 권한은 사용자가 개인 구글 계정으로 각자 동의해 발급받는다.
model GoogleCalendarLink {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @unique @map("user_id") @db.Uuid
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  googleEmail  String    @map("google_email")
  accessToken  String    @map("access_token")
  refreshToken String?   @map("refresh_token") // 최초 동의 시에만 내려옴 — 보관 필수
  tokenExpiry  DateTime? @map("token_expiry") @db.Timestamptz(6)
  scope        String?

  calendarId  String    @default("primary") @map("calendar_id")
  syncEnabled Boolean   @default(true) @map("sync_enabled")
  syncToken   String?   @map("sync_token") // 구글 증분 동기화 토큰
  lastSyncAt  DateTime? @map("last_sync_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("google_calendar_link")
}

// ── AIX-03: AI 비서 (Claude 도구 사용 루프) ──
// 사용자가 시킨 일을 AI가 ERP 도구(조회·등록·발송)로 나눠 실행한다. AI는 요청한 사용자의
// 권한·조직범위로만 움직이고, 쓰기·발송 도구는 사용자가 승인해야 실행된다.
model AiConversation {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String   @default("새 대화")
  // 사용자가 직접 바꾼 제목 — 자동 제목(첫 질문 요약)으로 덮어쓰지 않는다
  titleManual Boolean  @default(false) @map("title_manual")
  // Claude Messages API 대화 원문. thinking 블록까지 받은 그대로 이어 붙인다(중간 수정 금지 — 수정하면 API가 거부)
  messages    Json     @default("[]")
  // 승인 대기 중인 도구 호출 묶음. 승인·거절이 끝나야 다음 턴으로 넘어간다
  pending     Json?
  status      String   @default("IDLE") // IDLE | RUNNING | AWAITING_APPROVAL | ERROR
  lastError   String?  @map("last_error") // ERROR일 때 이유(키 미설정·한도 초과 등) — 다시 시도하면 지운다
  // 코드 실행(Anthropic 샌드박스) 컨테이너 — 같은 대화에서는 이어 써서 만든 파일·작업 상태를 유지한다
  containerId String?  @map("container_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  toolCalls AiToolCall[]
  files     AiFile[]

  @@index([userId, updatedAt])
  @@map("ai_conversation")
}

/// AI가 만든 파일(엑셀·PDF·CSV·차트 등) — 채팅 화면에서 내려받는다. 데모 규모라 내용은 DB(bytea)에 둔다
model AiFile {
  id             String          @id @default(uuid()) @db.Uuid
  // AI 비서 대화에서 만든 파일이면 대화, 에이전트 실행에서 만든 파일이면 실행에 붙는다(둘 중 하나)
  conversationId String?         @map("conversation_id") @db.Uuid
  conversation   AiConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agentRunId     String?         @map("agent_run_id") @db.Uuid
  agentRun       AgentRun?       @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  // 이 파일을 만든 도구 호출(create_report_file의 tool_use id, 코드 실행의 server_tool_use id) — 화면에서 그 줄 아래에 붙인다
  toolUseId      String          @map("tool_use_id")
  source         String // REPORT(서버 보고서 도구) | CODE(코드 실행 샌드박스)
  // 코드 실행 결과 파일의 Anthropic Files API id — 같은 파일을 두 번 저장하지 않게
  remoteFileId   String?         @unique @map("remote_file_id")
  name           String
  mediaType      String          @map("media_type")
  size           Int
  bytes          Bytes
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([conversationId])
  @@index([agentRunId])
  @@map("ai_file")
}

/// AI가 실행(또는 요청)한 도구 호출 이력 — 누가 무엇을 승인했는지 남기는 감사 기록
model AiToolCall {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolUseId      String         @map("tool_use_id")
  toolName       String         @map("tool_name")
  mode           String // READ | WRITE
  input          Json
  status         String // DONE | ERROR | REJECTED
  result         Json? // 결과 요약(길면 잘라서 보관)
  approvedBy     String?        @map("approved_by") @db.Uuid // 쓰기 도구를 승인한 사용자
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([conversationId])
  @@map("ai_tool_call")
}

/// AIX-04: AI 에이전트 블루프린트 — 노드(시작·AI 판단·도구·분기·반복·가드레일·승인·출력)를 선으로 이은 그래프
model AgentBlueprint {
  id          String                @id @default(uuid()) @db.Uuid
  name        String
  description String                @default("")
  status      String                @default("DRAFT") // DRAFT(초안) | ACTIVE(사용중)
  // { version, nodes:[{id,type,label,position,config}], edges:[{id,source,sourceHandle,target}] }
  graph       Json                  @default("{\"version\":1,\"nodes\":[],\"edges\":[]}")
  // 마지막으로 그래프를 만들거나 고친 자연어 요청(없으면 직접 만든 것)
  prompt      String?
  // 공개 범위: PRIVATE(만든 사람만) | PUBLIC(전체 공개) | SHARED(고른 직원에게만)
  visibility  String                @default("PRIVATE")
  createdBy   String?               @map("created_by") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  runs        AgentRun[]
  shares      AgentBlueprintShare[]
  references  AgentReferenceFile[]

  @@index([updatedAt])
  @@map("agent_blueprint")
}

/// 부분 공유한 에이전트를 쓸 수 있는 직원
model AgentBlueprintShare {
  blueprintId String         @map("blueprint_id") @db.Uuid
  blueprint   AgentBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  employeeId  String         @map("employee_id") @db.Uuid
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([blueprintId, employeeId])
  @@index([employeeId])
  @@map("agent_blueprint_share")
}

/// 블루프린트 테스트 실행 기록 — 노드별 단계 추적(trace)과 승인 대기 시 이어 갈 상태(state)
model AgentRun {
  id          String         @id @default(uuid()) @db.Uuid
  blueprintId String         @map("blueprint_id") @db.Uuid
  blueprint   AgentBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  input       Json           @default("{}")
  dryRun      Boolean        @default(true) @map("dry_run")
  status      String         @default("RUNNING") // RUNNING | DONE | ERROR | BLOCKED | AWAITING_APPROVAL | REJECTED
  trace       Json           @default("[]")
  // 승인 대기에서 이어 갈 때 필요한 실행 상태(변수·다음 노드·반복 스택)
  state       Json?
  output      Json?
  error       String?
  createdBy   String?        @map("created_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  files AiFile[]

  @@index([blueprintId, createdAt])
  @@map("agent_run")
}

/// 에이전트를 만들 때 올린 참고 양식(예: 주간 보고 엑셀) — 에이전트가 이 형식 그대로 파일을 만든다
model AgentReferenceFile {
  id          String          @id @default(uuid()) @db.Uuid
  // 대화로 만드는 중에는 아직 블루프린트가 없다 — 만들면 붙는다
  blueprintId String?         @map("blueprint_id") @db.Uuid
  blueprint   AgentBlueprint? @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  name        String
  mediaType   String          @map("media_type")
  size        Int
  bytes       Bytes
  // 서버가 읽어 낸 구조(시트·칸 위치·표 머리글) — AI가 양식을 이해하는 데 쓴다
  structure   Json            @default("{}")
  createdBy   String?         @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([blueprintId])
  @@map("agent_reference_file")
}

// 대시보드 — 템플릿(관리자가 만들고 권한 그룹·사용자에게 지정) 또는 개인 대시보드(ownerUserId)
model Dashboard {
  id            String                @id @default(uuid()) @db.Uuid
  name          String
  description   String                @default("")
  // { version: 1, items: [{ id, widget, viz, x, y, w, h, title?, period?, metric?, text? }] }
  layout        Json                  @default("{\"version\":1,\"items\":[]}")
  // 템플릿: 지정이 없는 사람에게 보여 줄 기본 대시보드
  isDefault     Boolean               @default(false) @map("is_default")
  // 템플릿: 받은 사람이 자기 대시보드로 고쳐 쓸 수 있나
  allowPersonal Boolean               @default(true) @map("allow_personal")
  // 차트 색 — 통인 테마색(tongin) 또는 애플 시스템 색(blue·green …). 개인 대시보드는 받은 템플릿 색을 따른다
  color         String                @default("tongin")
  // 개인 대시보드면 주인(템플릿이면 NULL)
  ownerUserId   String?               @unique @map("owner_user_id") @db.Uuid
  createdBy     String?               @map("created_by") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignments   DashboardAssignment[]

  @@map("dashboard")
}

/// 템플릿을 누구에게 기본으로 보여 줄지 — 권한 그룹(ROLE) 또는 사용자(USER) 하나에 템플릿 하나
model DashboardAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  dashboardId String    @map("dashboard_id") @db.Uuid
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  targetType  String    @map("target_type") // ROLE | USER
  targetId    String    @map("target_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([targetType, targetId])
  @@index([dashboardId])
  @@map("dashboard_assignment")
}
