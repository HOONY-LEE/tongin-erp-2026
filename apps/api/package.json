{
  "name": "@tongin/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "demo:seed": "tsx prisma/seed-demo.ts",
    "demo:seed:cases": "tsx prisma/seed-demo-cases.ts",
    "demo:seed:ops": "tsx prisma/seed-demo-ops.ts",
    "demo:seed:regions": "tsx prisma/seed-demo-regions.ts",
    "demo:seed:calendar": "tsx prisma/seed-demo-calendar.ts",
    "demo:seed:campaigns": "tsx prisma/seed-demo-campaigns.ts",
    "demo:seed:anomaly": "tsx prisma/seed-demo-anomaly.ts",
    "demo:seed:agents": "tsx prisma/seed-demo-agents.ts",
    "demo:seed:dashboards": "tsx prisma/seed-demo-dashboards.ts",
    "demo:seed:once": "tsx prisma/seed-demo-once.ts",
    "demo:seed:all": "pnpm demo:seed && pnpm demo:seed:cases && pnpm demo:seed:ops && pnpm demo:seed:regions && pnpm demo:seed:calendar && pnpm demo:seed:campaigns && pnpm demo:seed:anomaly && pnpm demo:seed:agents && pnpm demo:seed:dashboards"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.1.0",
    "@tongin/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exceljs": "^4.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.7",
    "prisma": "^6.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  }
}
