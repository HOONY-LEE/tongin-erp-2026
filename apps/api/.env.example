DATABASE_URL="postgresql://tongin:tongin@localhost:5433/tongin?schema=public"
PORT=3001

# 인증 (FND-03) — 운영에서는 반드시 강한 값으로 설정. 시크릿은 레포 커밋 금지.
JWT_SECRET="dev-insecure-secret-change-me"
# 부팅 시 초기 관리자(admin) 비밀번호. 미설정 시 기본값 admin1234 사용(개발 전용).
ADMIN_PASSWORD="admin1234"

# (선택) 기업이전 B2B 문서 직인 이미지 URL (EST-04). 미설정 시 (직인) 자리표시.
# COMPANY_SEAL_URL="https://.../seal.png"

# (선택) 카카오 Local REST API 키 (ADDR-01 주소→좌표 지오코딩).
# 미설정 시 우편번호·주소만 저장(좌표 생략). 발급: developers.kakao.com → 앱 → 플랫폼 키 → REST API 키.
# 사용 전 콘솔에서 제품 설정 > 카카오맵 '사용 설정 ON' 필요.
# KAKAO_REST_API_KEY="your-rest-api-key"

# (선택) 구글 캘린더 연동 (CAL-01). 미설정 시 자체 캘린더만 동작하며
# 프론트에서는 "관리자 미설정" 안내가 표시된다.
# 발급: console.cloud.google.com → API 및 서비스 → 사용자 인증 정보 →
#   OAuth 클라이언트 ID(웹 애플리케이션) 생성. Google Calendar API 사용 설정 필요.
#   승인된 리디렉션 URI에 GOOGLE_REDIRECT_URI 값을 그대로 등록할 것.
# 앱 자격증명은 공용이고, 실제 캘린더 접근 권한은 사용자가 각자 개인 구글 계정으로 동의해 발급받는다.
# GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-client-secret"
# GOOGLE_REDIRECT_URI="http://localhost:3001/api/calendar/google/callback"
# WEB_APP_URL="http://localhost:3002"

# AI 비서 (AIX-03) — Claude API 키. 미설정 시 AI 비서 화면에 "미연결" 안내가 뜨고 /api/ai 대화 요청은 503.
# 발급: platform.claude.com → API Keys. 키는 서버에만 두고 커밋 금지.
# ANTHROPIC_API_KEY="sk-ant-..."
# (선택) 모델 바꾸기. 기본 claude-opus-5-5
# AI_MODEL="claude-opus-5-5"

# 문자(SMS) 발송 — 알리고. 미설정 시 스텁(실제 전송 없이 notification 기록만).
# 준비: smartsms.aligo.in 가입 → 포인트 충전 → 발신번호 등록(본인 휴대폰 인증) →
#       API 연동 신청에서 키 발급 + 발송 서버 IP(내 PC 공인 IP) 등록.
# ALIGO_API_KEY=""
# ALIGO_USER_ID=""
# ALIGO_SENDER="01012345678"       # 알리고에 등록한 발신번호
# ALIGO_TESTMODE="Y"               # Y면 과금·실발송 없이 연동만 확인
# 운영(NODE_ENV=production)이 아니면 아래 번호로만 실제 발송(시드의 가짜 번호로 나가는 것 방지). 콤마 구분.
# SMS_ALLOWED_RECIPIENTS="01012345678,01098765432"

# ── 배포 ──
# 웹이 API와 다른 도메인일 때만 필요(같은 도메인 프록시면 비워 둔다). 콤마 구분.
# CORS_ORIGINS="https://tongin.example.com"
# 컨테이너 포트(플랫폼이 주입하는 경우가 많다)
# PORT="3001"
#
# 파일 저장(작업 사진 등). S3 또는 S3 호환(Cloudflare R2 등).
# STORAGE_ENDPOINT=""            # R2 등 S3 호환이면 엔드포인트, AWS S3면 비움
# STORAGE_REGION="ap-northeast-2"
# STORAGE_BUCKET="tongin-uploads"
# STORAGE_ACCESS_KEY_ID=""
# STORAGE_SECRET_ACCESS_KEY=""
